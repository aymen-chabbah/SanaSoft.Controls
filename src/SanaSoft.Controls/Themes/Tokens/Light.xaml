<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="clr-namespace:SanaSoft.Controls.Themes">

    <!-- Light palette. Dark.xaml must define exactly the same keys. -->
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.BackgroundBrush}" Color="#FFF7F8FA" />
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.SurfaceBrush}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.SurfaceHoverBrush}" Color="#FFF2F4F7" />
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.SurfacePressedBrush}" Color="#FFE4E7EC" />
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.DisabledSurfaceBrush}" Color="#FFF2F4F7" />
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.BorderBrush}" Color="#FFD0D5DD" />
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.BorderHoverBrush}" Color="#FF98A2B3" />
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.ForegroundBrush}" Color="#FF101828" />
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.SecondaryForegroundBrush}" Color="#FF475467" />
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.DisabledForegroundBrush}" Color="#FF98A2B3" />
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.AccentBrush}" Color="#FF2563EB" />
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.AccentHoverBrush}" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.AccentPressedBrush}" Color="#FF1E40AF" />
    <SolidColorBrush x:Key="{x:Static themes:ResourceKeys.AccentForegroundBrush}" Color="#FFFFFFFF" />

</ResourceDictionary>
